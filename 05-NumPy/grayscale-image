import numpy as np
from PIL import Image

image_path = "profile.png"
output_image = "profile_gray.png"

orginal_img = Image.open(image_path)
image_data = np.asarray(orginal_img )

print(f"imag shap: {image_data.shape}")

red_channel = image_data[:,:,0]
print(f"red channel: {red_channel},mean: {red_channel.mean()}, min: {red_channel.min()}")

# Y = 0.2126R + 0.7152G + 0.0722B
weights = [0.2126, 0.7152, 0.0722]
grayscale_image_data = image_data @ weights
grayscale_image_data = grayscale_image_data.astype('uint8')

grayscale_image = Image.fromarray(grayscale_image_data)
grayscale_image.save(output_image)
